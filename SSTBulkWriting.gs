function sstInstallBulkRubricOption(){
 sstWritingStepsQA_();
 const ss=sstBook_(),q=ss.getSheetByName('Q&A - Start Here');const entries=[
 ['Writing feedback','Can I switch everybody back to Rubric without changing each student one by one?','Yes. SST Case Manager → Writing feedback → Switch everyone to Rubric → All connected writing areas. Or choose One writing area and select Spanish Narrative or English Opinion. It changes modes only for active SST students and enabled supported connections. Individual controls remain available in Writing Controls.','Bulk Rubric option'],
 ['Writing feedback','Will switching everybody to Rubric immediately erase my manual writing?','No. The mode change leaves current General text unchanged. When you next click Update Writing Feedback, valid matched rubric feedback may replace previous manual entries in the areas you switched. Missing, incomplete, ambiguous and ungraded rubric entries are still skipped. Other writing areas retain their modes. Import History saves replaced text for Restore last writing import.','Update is a separate step']];
 if(q){const old=new Set(q.getDataRange().getDisplayValues().flat()),fresh=entries.filter(r=>!old.has(r[1]));if(fresh.length){const row=q.getLastRow()+1;q.getRange(row,1,fresh.length,4).setValues(fresh).setWrap(true).setVerticalAlignment('top');q.autoResizeRows(row,fresh.length);}}
 const controls=ss.getSheetByName(SRC_SHEETS.controls);if(controls)controls.getRange('A4:G4').setValue('For everyone at once: SST Case Manager → Writing feedback → Switch everyone to Rubric. Choose all connected areas or just one. Then click Update Writing Feedback when ready. For ambiguous names, enter the exact rubric name in column D.');
 const people=srcPeople_(ss),rows=controls.getRange(7,1,controls.getLastRow()-6,10).getValues(),fields=srcConnectedWritingFields_(ss),all=srcBulkRows_(people,rows,fields);if(all.length!==people.length*fields.length)throw Error('Bulk controls did not cover every active student.');fields.forEach(f=>{if(srcBulkRows_(people,rows,[f]).length!==people.length)throw Error('Area selection check failed: '+f);});
 const fake=[['','','Manual','','','','','active','Narrativa-Spa'],['','','Rubric','','','','','inactive','Narrativa-Spa'],['','','Manual','','','','','active','Opinion-Eng']];if(srcBulkRows_([{id:'active'}],fake,['Narrativa-Spa']).length!==1)throw Error('Student/area isolation check failed.');
 try{sstBuildMenus_();}catch(e){}console.log('PASS: bulk all-connected and individual-area coverage, active-student filtering, manual-entry eligibility and area isolation verified. Q&A updated. No writing text or modes changed.');
}


// Bulk mode changes affect controls only. Writing text changes only on Update.
function srcConnectedWritingFields_(ss){const s=ss.getSheetByName(SRC_SHEETS.connections);if(!s||s.getLastRow()<7)return [];const rows=s.getRange(7,1,s.getLastRow()-6,4).getValues();return [...new Set(rows.filter(r=>r[0]===true&&r[1]&&['Narrative','Opinion'].includes(r[2])).map(r=>srcField_(r[2],r[3])).filter(Boolean))];}
function srcBulkRows_(people,controls,fields){const active=new Set(people.map(p=>p.id)),wanted=new Set(fields);return controls.map((r,i)=>({r,index:i+7})).filter(x=>active.has(x.r[7])&&wanted.has(x.r[8]));}
function srcBulkRubric_(field){
 const ss=sstBook_(),lock=LockService.getDocumentLock();lock.waitLock(30000);
 try{const connected=srcConnectedWritingFields_(ss),fields=field?[field]:connected;if(!fields.length)throw Error('Enable a Narrative or Opinion connection in Rubric Connections first.');if(fields.some(f=>!connected.includes(f)))throw Error('That writing area has no enabled supported rubric connection.');
 const people=srcPeople_(ss),control=ss.getSheetByName(SRC_SHEETS.controls);if(!control||control.getLastRow()<7)throw Error('Use Refresh Writing Controls for new students first.');const rows=control.getRange(7,1,control.getLastRow()-6,10).getValues(),targets=srcBulkRows_(people,rows,fields),cols=srcColumns_(ss),g=ss.getSheetByName('General');
 if(targets.length!==people.length*fields.length)throw Error('Writing controls are missing or duplicated. Run Refresh Writing Controls for new students, then try again.');
 const jobs=targets.map(x=>{const p=people.find(p=>p.id===x.r[7]);return {row:x.index,current:g.getRange(p.row,cols[x.r[8]]).getValue(),old:control.getRange(x.index,3,1,8).getValues()[0]};});
 try{jobs.forEach(j=>{control.getRange(j.row,10).setValue(j.current);control.getRange(j.row,3).setValue('Rubric');control.getRange(j.row,5).setValue('Rubric enabled for everyone — run Update Writing Feedback');});}catch(error){jobs.forEach(j=>control.getRange(j.row,3,1,8).setValues([j.old]));throw error;}
 ss.setActiveSheet(control);control.getRange('A1').activate();const message=jobs.length+' writing areas switched to Rubric. Current writing text is unchanged. Update Writing Feedback will replace valid matches, including previous manual entries in these areas.';ss.toast(message,'Rubric mode enabled',15);return message;
 }finally{lock.releaseLock();}
}
function sstEveryoneToRubric(){return srcBulkRubric_('');}
function sstBulkRubricArea(field){return srcBulkRubric_(String(field||''));}
function sstChooseBulkRubricArea(){
 const ss=sstBook_(),fields=srcConnectedWritingFields_(ss);if(!fields.length){ss.toast('Enable a supported connection in Rubric Connections first.','No connected writing areas',10);return;}
 const options=fields.map(f=>'<option value="'+f+'">'+f+'</option>').join('');
 const html='<!doctype html><html><head><style>body{font:14px Arial;color:#223f53;margin:18px;line-height:1.45}select,button{font:14px Arial;padding:9px;width:100%;margin:8px 0}button{background:#246962;color:white;border:0;border-radius:4px}button.cancel{background:white;color:#223f53;border:1px solid #aaa}#status{white-space:pre-wrap}</style></head><body><p>Switch every active SST student to <b>Rubric</b> for one writing area.</p><label for="area">Writing area</label><select id="area">'+options+'</select><p>Current text stays unchanged until you click <b>Update Writing Feedback</b>. That update can replace previous manual entries in this area. Other writing areas keep their modes.</p><button id="go" onclick="run()">Switch everyone to Rubric</button><button class="cancel" onclick="google.script.host.close()">Close</button><p id="status" role="status"></p><script>function run(){var b=document.getElementById("go");b.disabled=true;document.getElementById("status").textContent="Switching modes…";google.script.run.withSuccessHandler(function(message){document.getElementById("status").textContent=message;}).withFailureHandler(function(e){document.getElementById("status").textContent=e.message;b.disabled=false;}).sstBulkRubricArea(document.getElementById("area").value);}</script></body></html>';
 SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(html).setWidth(440).setHeight(420),'Everyone to Rubric — one writing area');
}

function sstWritingStepsQA_(){
 const ss=sstBook_(),q=ss.getSheetByName("Q&A - Start Here"),title="WRITING FEEDBACK — STEP-BY-STEP GUIDE";if(!q)throw Error("Q&A tab missing");
 const all=q.getRange(1,1,q.getLastRow(),4).getDisplayValues();let i=all.findIndex(r=>r[1]===title),start=i>=0?i+1:q.getLastRow()+2;
 const rows=[["Writing — steps","1. Find the writing feedback in General","1) Open General.\n2) Find the student’s row.\n3) Spanish Narrative feedback appears under Narrativa-Spa (currently column X).\n4) English Opinion feedback appears under Opinion-Eng (currently column AB).\n5) Writing Controls shows whether each area is Manual or Rubric.","Same General cells"],["Writing — steps","2. Connect a new rubric or a new class","1) Make a working copy of the supported rubric MASTER and enter students and grades.\n2) Open Rubric Connections.\n3) On an unused row, paste the working copy’s Google Sheets link under Paste rubric link here.\n4) Choose Narrative or Opinion and the writing language. These first sources use Narrative + Spanish and Opinion + English.\n5) Check Enabled. If this replaces an older rubric for the same students and area, uncheck the old connection.\n6) Use Preview writing feedback before importing. Only students already in General are considered.","Reuse the same templates"],["Writing — steps","3. Update after changing grades or feedback notes","1) Finish and save the rubric selections or feedback-note edits.\n2) Return to the SST Case Manager.\n3) Open SST Case Manager → Writing feedback → Preview writing feedback.\n4) In Writing Import Review, check matches and any skipped entries.\n5) Choose SST Case Manager → Writing feedback → Update Writing Feedback.\n6) Review the results. Manual entries stay protected. This refresh is not an instant background sync.","One-click refresh"],["Writing — steps","4. Type my own feedback for one student","1) Open Writing Controls.\n2) Find the student AND the writing area you want.\n3) Choose Manual in Mode.\n4) Open General and type or paste in that student’s corresponding writing cell. If a protection reminder appears, click OK to edit.\n5) Future writing imports preserve it. Editing a writing cell directly in General also switches that entry to Manual; its status says Manual edit in General — preserved.","Only that student / area"],["Writing — steps","5. Return just one or two students to Rubric","1) Open Writing Controls.\n2) Find the first student and writing area.\n3) Change Mode from Manual to Rubric.\n4) Repeat only for any other student / area you want.\n5) Use SST Case Manager → Writing feedback → Update Writing Feedback.\n6) Valid matched rubric feedback can now replace those entries. Everyone left in Manual keeps their text.","Individual control"],["Writing — steps","6. Return everyone to Rubric for all connected areas","1) Open SST Case Manager → Writing feedback.\n2) Choose Switch everyone to Rubric → All connected writing areas.\n3) This switches active SST students to Rubric only for enabled supported writing connections. Current General text is unchanged at this step.\n4) Click Update Writing Feedback when ready. Valid rubric matches may then replace previous manual entries in those areas.\n5) Missing, ungraded, incomplete or ambiguous rubric entries are still skipped.","Everyone / connected areas"],["Writing — steps","7. Return everyone to Rubric for just ONE area","1) Open SST Case Manager → Writing feedback.\n2) Choose Switch everyone to Rubric → One writing area….\n3) In the popup, choose Narrativa-Spa or Opinion-Eng (the list follows your enabled connections).\n4) Click Switch everyone to Rubric, then Close.\n5) Click Update Writing Feedback when ready.\n6) Other writing areas keep their existing Manual / Rubric modes.","Everyone / one area"],["Writing — steps","8. Update others while keeping one student’s manual text","1) In Writing Controls, keep that student’s writing area set to Manual.\n2) Keep the areas you want refreshed set to Rubric.\n3) Change the other students’ rubric grades as needed.\n4) Click Update Writing Feedback.\n5) The Manual entry stays as you wrote it. You do not need to make the whole class automatic.","Manual entries preserved"],["Writing — steps","9. Understand a skipped entry in Writing Import Review","1) Read Result beside the student and writing area.\n2) Manual means the SST entry is protected.\n3) Ungraded or incomplete means finish the rubric; choose exactly one option in each select-one group.\n4) Not found means check the student names.\n5) Ambiguous means enter the exact full rubric name in Writing Controls column D.\n6) Conflict means disable the duplicate connection for that student / area.\n7) Correct the issue, then preview and update again. Skipped entries keep the existing SST text.","No blank overwrites"],["Writing — steps","10. Add a new SST student to the writing controls","1) Add the student in General using the Case Manager’s normal student workflow.\n2) Open SST Case Manager → Writing feedback → Refresh Writing Controls for new students.\n3) In Writing Controls, check the new student’s modes for each writing area. Choose Manual or Rubric as needed.\n4) Make sure the student is also named correctly and graded in the connected rubric.\n5) Preview and update. The import never adds the rest of your class to SST.","General controls membership"],["Writing — steps","11. Undo the latest writing import","1) Open SST Case Manager → Writing feedback.\n2) Choose Restore last writing import.\n3) Entries from the latest saved import return to their previous text only if you have not edited them since.\n4) Restored entries switch to Manual. Later manual edits remain protected.\n5) To import again later, switch the desired entries back to Rubric.","Latest import only"],["Writing — steps","12. Remember what is connected and supported","1) Spanish Narrative currently pulls directly into General → Narrativa-Spa.\n2) English Opinion currently pulls directly into General → Opinion-Eng.\n3) Other writing areas can stay manual. Informational rubrics are not supported yet.\n4) Copies of the supported Narrative / Opinion templates can be connected by link. Keep required tabs, headers and feedback identifiers intact.\n5) The old dropdown choices are in Writing Feedback Archive; the original library is retained hidden.\n6) Automatic here means you do not retype feedback: click Update Writing Feedback after rubric changes.","Current behavior"]];
 q.getRange(start,1,1,4).setValues([["WRITING FEEDBACK",title,"Choose the task below. Follow its numbered steps. Your writing text and Manual / Rubric modes are unchanged by this guide.","Installed"]]).setBackground("#246962").setFontColor("white").setFontWeight("bold").setWrap(true).setVerticalAlignment("top");
 const range=q.getRange(start+1,1,rows.length,4);range.setValues(rows).setWrap(true).setVerticalAlignment("top").setFontFamily("Arial").setFontSize(11).setFontColor("#223f53").setFontWeight("normal");q.getRange(start+1,2,rows.length,1).setFontWeight("bold");rows.forEach((r,j)=>q.getRange(start+1+j,1,1,4).setBackground(j%2?"#f2f6f5":"#ffffff"));q.autoResizeRows(start,rows.length+1);
 ss.setNamedRange("SST_WRITING_STEP_GUIDE",q.getRange(start,1));ss.setActiveSheet(q);q.getRange(start,2).activate();console.log("WRITING GUIDE: "+rows.length+" numbered workflows added at Q&A row "+start+". No writing text or modes changed.");
}
