// Student actions are coordinated across General, SST sources and saved records.
function sstInstallCaseActions(){
 const ss=sstBook_(),q=ss.getSheetByName('Q&A - Start Here');
 if(q){const r=q.getDataRange(),v=r.getValues(),f=r.getFormulas();v.forEach((row,ri)=>row.forEach((x,i)=>{if(typeof x==='string'&&x.includes('SST Progress')&&!f[ri][i])q.getRange(ri+1,i+1).setValue(x.replace(/SST Progress/g,'SST Case Manager'));}));
  const items=[
  ['Names and rows','What if I accidentally clear the name?','The name returns to keep its connections safe. A message stays on screen until you close its ×. Follow the path exactly: SST Case Manager → Student actions — edit name / archive / delete. Choose Edit name, Archive student, Delete student and data, or Cancel. If you see the old menu, reload the spreadsheet once.','Works now'],
  ['Names and rows','I entered a test name. How do I remove it?','Select the name in General → SST Case Manager → Student actions — edit name / archive / delete → Delete student and data. A second screen lists what will be cleared. Type the student name exactly, then confirm. Do not delete the spreadsheet row. A recovery copy stays in this same workbook.','Works now'],
  ['Names and rows','Should I remove or archive a student?','Archive keeps General and SST source information in place, hides Progress, and removes the student from active lists. Delete student and data clears that student’s General and SST source entries and removes their Progress tab from normal use. A hidden recovery copy is kept in this workbook; this is not a permanent purge. Restore a deleted student is a separate menu option.','Works now'],
  ['Student actions','How do I edit a name safely?','Select the existing student in General → SST Case Manager → Student actions — edit name / archive / delete → Edit name. Enter the corrected spelling and apply it. The same student identity and saved records are kept. You can also correct the existing Name cell directly, one student at a time. Do not overwrite a departing student with a different child.','Works now'],
  ['Goals and progress','If I clear goals in SST 1, SST2 or SST3, does the Progress tab disappear?','No. Clear only the goal and plan input cells you intended to change. A draft updates and no longer displays the cleared goal. A started meeting keeps its saved goal wording and results; a source change requires review and Revise goal / plan. Clearing source goals does not erase the student or their saved progress, and an empty draft meeting section may remain.','Works now'],
  ['Student actions','Can I undo Delete student and data?','Use SST Case Manager → Students — General → Restore a deleted student. Recovery includes the saved General entry, SST sources and the original Progress sheet if one existed. Restoration checks that the original source rows and name are still available before writing anything. If a row has been reused, restoration stops instead of overwriting it; ask for help. Ctrl+Z is not a reliable undo for script actions.','Works now'],
  ['Menus and help','Why is the menu called SST Case Manager now?','It manages names, student records, SST 1/2/3 goals, saved Progress, printing and shared Progress dropdowns. Tracker controls — add progress rows / student actions contains row controls and a link to the same student actions. These names match the paths shown in help.','Works now']];
  items.forEach(item=>{const rows=q.getDataRange().getDisplayValues(),found=rows.findIndex(r=>r[1]===item[1]),row=found>=0?found+1:q.getLastRow()+1;q.getRange('A106:D106').copyTo(q.getRange(row,1,1,4),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);q.getRange(row,1,1,4).setValues([item]).setWrap(true).setFontFamily('Arial').setFontSize(11);q.autoResizeRows(row,1);});}
 ss.getSheets().forEach(s=>{const r=s.getDataRange(),n=r.getNotes();let changed=false;n.forEach(row=>row.forEach((x,i)=>{if(x.includes('SST Progress')){row[i]=x.replace(/SST Progress/g,'SST Case Manager').replace(/Remove unused entry or archive student/g,'Student actions — edit name / archive / delete');changed=true;}}));if(changed)r.setNotes(n);});
 const h=ss.getSheetByName('General').getRange('A2');h.setNote(h.getNote().split('\nREMOVE OR ARCHIVE')[0]+'\nSTUDENT ACTIONS: SST Case Manager → Student actions — edit name / archive / delete. Edit name keeps the same saved records. Archive keeps information and hides the student from active lists. Delete clears this student’s General and SST entries, with a second confirmation and a hidden recovery copy. Do not delete spreadsheet rows. A name-clearing message stays until you close its ×.');
 console.log('CASE ACTIONS INSTALLED '+JSON.stringify({students:sstPeople_(ss).length,menu:'SST Case Manager',nameClearingMessageTimeout:-1,deleteRequiresTypedName:true,recoveryCopy:true}));
}
function sstCaseSelection_(ss){const s=ss.getActiveSheet(),row=s.getActiveRange().getRow();if(s.getName()==='General'&&row>=3)return s.getRange(row,1).getDisplayValue().trim();const e=Object.values(sstRegistry_()).find(e=>e.sheetId===s.getSheetId());return e?e.name:ss.getSheetByName(SST_INDEX).getRange('B3').getDisplayValue().trim();}
function sstCaseSourceReads_(ss){const cache={};SST_ROUNDS.forEach(title=>{const s=ss.getSheetByName(title),rows=s.getRange(2,1,Math.max(2,s.getLastRow())-1,62).getDisplayValues(),heads=rows[0].slice(44,62);rows.slice(1).forEach(row=>{const name=sstKey_(row[0]);if(!name)return;const key=title+':'+name;if(cache[key])throw Error('Duplicate student name in '+title+': '+row[0]);cache[key]={values:row.slice(44,62),heads};});});return cache;}
function sstShowStudentActions(name,mode){
 const ss=sstBook_(),people=sstPeople_(ss),registry=sstRegistry_();name=name||sstCaseSelection_(ss);if(!people.length){SpreadsheetApp.getUi().alert('There are no active source entries. Use Restore a deleted student if needed.');return;}
 const data=JSON.stringify({selected:name,mode:mode||'',students:people.map(p=>({name:p.name,archived:!!(registry[sstKey_(p.name)]||{}).archived}))}).replace(/</g,'\\u003c');
 const html='<!doctype html><html><head><style>body{font:14px Arial;color:#111;line-height:1.5;margin:22px}h2{font-size:20px;margin:0 0 12px}h3{font-size:16px;margin-bottom:8px}label{display:block;font-weight:bold;margin:12px 0 5px}select,input{box-sizing:border-box;width:100%;padding:10px;border:1px solid #72838a;font:15px Arial}button{padding:10px 14px;margin:10px 6px 0 0;border:1px solid #586e78;border-radius:3px;background:#edf3f0;font:bold 14px Arial;cursor:pointer}button:disabled{opacity:.45;cursor:default}.danger{background:#fff1ed;border-color:#a8432c}.box{border:1px solid #bfcbd1;padding:14px;margin-top:16px}.help{color:#333}#status{white-space:pre-wrap} [hidden]{display:none!important}</style></head><body><h2>What would you like to do?</h2><label for="student">Student</label><select id="student"></select><div id="options"><button id="edit">Edit name</button><button id="archive">Archive student</button><button id="restore">Restore archived student</button><button id="delete" class="danger">Delete student and data…</button><p class="help"><b>Edit name:</b> correct the spelling and keep the same records.<br><b>Archive:</b> keep information and hide the student from active lists.<br><b>Delete:</b> clear this student’s entries and remove their Progress tab from normal use. A hidden recovery copy stays in this workbook.</p></div><div id="editBox" class="box" hidden><label for="newName">Corrected student name</label><input id="newName"><button id="applyName">Apply name correction</button><button class="back">Back</button></div><div id="deleteBox" class="box danger" hidden><h3>Are you sure you want to delete this student and their data?</h3><p id="warning"></p><p>This clears their entry in General and all three SST source tabs, and removes their Progress tab from normal use. It does not delete spreadsheet rows or other students. A hidden recovery copy stays in this workbook. Files already downloaded or saved elsewhere are not affected.</p><label for="confirmName">Type the student name exactly to confirm</label><input id="confirmName" autocomplete="off"><button id="confirmDelete" class="danger" disabled>Yes, delete this student and data</button><button class="back">Cancel deletion</button></div><p id="status" role="status"></p><button id="close">Close / Cancel</button><script>const initial='+data+';('+sstCaseActionsClient_.toString()+')();</script></body></html>';
 SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(html).setWidth(620).setHeight(680),'Student actions — edit name / archive / delete');
}
function sstCaseActionsClient_(){
 const $=id=>document.getElementById(id);let done=false;initial.students.forEach(p=>{const o=document.createElement('option');o.value=p.name;o.textContent=p.name+(p.archived?' (archived)':'');o.selected=p.name===initial.selected;$('student').appendChild(o);});
 function name(){return $('student').value;}function base(){if(done)return;$('options').hidden=false;$('editBox').hidden=$('deleteBox').hidden=true;$('status').textContent='';const p=initial.students.find(p=>p.name===name());$('archive').disabled=p.archived;$('restore').disabled=!p.archived;}
 function deleting(){$('options').hidden=$('editBox').hidden=true;$('deleteBox').hidden=false;$('warning').textContent='Student: '+name();$('confirmName').value='';$('confirmDelete').disabled=true;}
 function run(action,arg){document.querySelectorAll('button,select,input').forEach(e=>e.disabled=true);$('status').textContent='Working…';google.script.run.withSuccessHandler(r=>{done=true;$('options').hidden=$('editBox').hidden=$('deleteBox').hidden=true;$('status').textContent=r.message;$('close').disabled=false;$('close').textContent='Close';}).withFailureHandler(e=>{document.querySelectorAll('button,select,input').forEach(e=>e.disabled=false);$('status').textContent=e.message||String(e);$('confirmDelete').disabled=$('confirmName').value!==name();}).sstCaseStudentAction(action,name(),arg||{});}
 $('student').onchange=base;$('edit').onclick=()=>{$('options').hidden=true;$('editBox').hidden=false;$('newName').value=name();};$('applyName').onclick=()=>run('rename',{newName:$('newName').value});$('archive').onclick=()=>run('archive');$('restore').onclick=()=>run('restore');$('delete').onclick=deleting;$('confirmName').oninput=()=>{$('confirmDelete').disabled=$('confirmName').value!==name();};$('confirmDelete').onclick=()=>run('delete',{confirmName:$('confirmName').value});document.querySelectorAll('.back').forEach(b=>b.onclick=base);$('close').onclick=()=>google.script.host.close();base();if(initial.mode==='delete')deleting();
}
function sstCaseStudentAction(action,name,arg){
 if(action==='archive'||action==='restore')return sstManageAction(action,name,{});
 const ss=sstBook_(),lock=LockService.getDocumentLock();lock.waitLock(30000);
 try{
  const p=sstPeople_(ss).find(p=>sstKey_(p.name)===sstKey_(name)),registry=sstRegistry_(),entry=registry[sstKey_(name)];if(!p||!entry||!entry.studentId)throw Error('The student connection needs checking. Nothing was changed.');
  if(PropertiesService.getDocumentProperties().getProperty('SST_PENDING_NAME_CORRECTION'))throw Error('Finish the pending name correction first.');
  if(action==='rename'){
   const newName=String(arg.newName||'').trim().replace(/\s+/g,' ');if(!newName)throw Error('Enter the corrected name.');if(newName===p.name)return{message:'The spelling is unchanged. No records were changed.'};
   const cell=ss.getSheetByName('General').getRange(p.row,1);cell.setValue(newName);
   try{const job=sstPrepareNameCorrection_(ss,p.name,newName,p.row,entry);PropertiesService.getDocumentProperties().setProperty('SST_PENDING_NAME_CORRECTION',JSON.stringify(job));sstFinishNameCorrection_(ss,job);}catch(e){if(!PropertiesService.getDocumentProperties().getProperty('SST_PENDING_NAME_CORRECTION'))cell.setValue(p.name);throw e;}
   return{message:'Name corrected to '+newName+'. The same student identity, goals, dates and progress were kept.'};
  }
  if(action!=='delete'||arg.confirmName!==p.name)throw Error('Type the student name exactly before confirming deletion. Nothing was changed.');
  const sources=SST_ROUNDS.map(title=>{const s=ss.getSheetByName(title),v=s.getRange(3,1,s.getMaxRows()-2,1).getDisplayValues().flat(),rows=[];v.forEach((x,i)=>{if(sstKey_(x)===sstKey_(p.name))rows.push(i+3);});if(rows.length!==1)throw Error('Check the student name connection in '+title+'. Nothing was deleted.');return{title,row:rows[0]};});
  const kept=sstRemovalKeptData_(ss,p.name),others=JSON.stringify(Object.entries(registry).filter(([k])=>k!==sstKey_(p.name))),progress=entry.sheetId?ss.getSheetById(entry.sheetId):null;
  if(entry.sheetId&&!progress)throw Error('The saved Progress sheet is missing. Nothing was deleted.');
  const token=Utilities.getUuid(),snapshot={token,name:p.name,at:new Date().toISOString(),entry,general:sstCasePackRow_(ss.getSheetByName('General'),p.row),sources:sources.map(x=>({...x,data:sstCasePackRow_(ss.getSheetByName(x.title),x.row)})),progressTitle:progress?progress.getName():null};
  const recovery=sstCaseSaveRecovery_(ss,snapshot);
  sources.forEach(x=>{const s=ss.getSheetByName(x.title);s.getRange(x.row,2).clearContent();s.getRange(x.row,63).clearContent();s.getRange(x.row,1,1,s.getMaxColumns()).clearContent().clearNote();});
  const general=ss.getSheetByName('General');general.getRange(p.row,1,1,general.getMaxColumns()).clearContent().clearNote();
  if(entry.generalNameRange)ss.removeNamedRange(entry.generalNameRange);delete registry[sstKey_(p.name)];sstSaveRegistry_(registry);SST_ROW_CACHE_={};
  const index=ss.getSheetByName(SST_INDEX);if(sstKey_(index.getRange('B3').getDisplayValue())===sstKey_(p.name))index.getRange('B3').clearContent();ss.setActiveSheet(index);
  if(progress){progress.setName(('Deleted - '+p.name+' - '+token.slice(0,8)).slice(0,100));progress.hideSheet();}
  ss.getSheetById(recovery.sheetId).getRange(recovery.row,1).setValue('deleted');PropertiesService.getDocumentProperties().deleteProperty('SST_INDEX_ROSTER_V2');sstIndex_(ss,sstPeople_(ss));SpreadsheetApp.flush();
  if(kept!==sstRemovalKeptData_(ss,p.name)||others!==JSON.stringify(Object.entries(sstRegistry_()).filter(([k])=>k!==sstKey_(p.name))))throw Error('Deletion finished but the preservation check needs review. A recovery copy is saved.');
  console.log('STUDENT DELETED '+JSON.stringify({name:p.name,recoveryToken:token,otherStudentsAndProgressPreserved:true}));return{message:'Deleted '+p.name+' from General, SST 1/2/3 and active Progress. Other students were kept. To undo: SST Case Manager → Students — General → Restore a deleted student. A hidden recovery copy stays in this workbook.'};
 }finally{lock.releaseLock();}
}
function sstCasePackRow_(sheet,row){const r=sheet.getRange(row,1,1,sheet.getMaxColumns());return{row,values:r.getValues()[0].map(v=>v instanceof Date?{sstDate:v.toISOString()}:v),formulas:r.getFormulas()[0],notes:r.getNotes()[0]};}
function sstCaseRecoverySheet_(ss){let s=ss.getSheetByName('_SST Recovery');if(!s){s=ss.insertSheet('_SST Recovery');s.getRange('A1:E1').setValues([['State','Recovery key','Student','Saved at','Recovery data — use the restore menu']]);sstSetEditingWarning_(s,[]);s.hideSheet();}return s;}
function sstCaseSaveRecovery_(ss,snapshot){const s=sstCaseRecoverySheet_(ss),text=JSON.stringify(snapshot),chunks=[];for(let i=0;i<text.length;i+=8000)chunks.push(text.slice(i,i+8000));const row=s.getLastRow()+1;if(row+chunks.length>s.getMaxRows())s.insertRowsAfter(s.getMaxRows(),Math.max(100,chunks.length+1));s.getRange(row,1,1,5).setValues([['deleting',snapshot.token,snapshot.name,snapshot.at,String(chunks.length)]]);s.getRange(row+1,1,chunks.length,5).setValues(chunks.map(x=>['payload',snapshot.token,'','',x]));SpreadsheetApp.flush();return{sheetId:s.getSheetId(),row};}
function sstCaseDeleted_(ss){const s=ss.getSheetByName('_SST Recovery');if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,5).getDisplayValues().map((v,i)=>({state:v[0],token:v[1],name:v[2],at:v[3],chunks:Number(v[4]),row:i+2})).filter(x=>x.state==='deleted');}
function sstRestoreDeletedStudent(){
 const ss=sstBook_(),entries=sstCaseDeleted_(ss);if(!entries.length){SpreadsheetApp.getUi().alert('There are no deleted student entries to restore. For an archived student, use Tracker controls → Restore selected student.');return;}
 const data=JSON.stringify(entries).replace(/</g,'\\u003c');const html='<!doctype html><html><body style="font:15px Arial;line-height:1.5;padding:20px"><h2>Restore a deleted student</h2><p>The recovery copy includes their General entry, SST source entries and saved Progress sheet if one existed. If an original source row is in use, restoration stops instead of overwriting it.</p><select id="entry" style="width:100%;padding:10px;font:15px Arial"></select><button id="restore" style="margin-top:16px;padding:12px">Restore selected deleted student</button><p id="status" role="status"></p><button onclick="google.script.host.close()">Close</button><script>const entries='+data+';for(const e of entries){const o=document.createElement("option");o.value=e.token;o.textContent=e.name+" — "+new Date(e.at).toLocaleString();document.getElementById("entry").appendChild(o);}document.getElementById("restore").onclick=()=>{const b=document.getElementById("restore");b.disabled=true;document.getElementById("status").textContent="Working…";google.script.run.withSuccessHandler(r=>{document.getElementById("status").textContent=r.message;}).withFailureHandler(e=>{document.getElementById("status").textContent=e.message;b.disabled=false;}).sstCaseRestoreAction(document.getElementById("entry").value);};</script></body></html>';
 SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(html).setWidth(580).setHeight(430),'Restore a deleted student');
}
function sstCaseRestoreAction(token){
 const ss=sstBook_(),lock=LockService.getDocumentLock();lock.waitLock(30000);try{
  const item=sstCaseDeleted_(ss).find(x=>x.token===token);if(!item)throw Error('This recovery entry is no longer available.');const recovery=ss.getSheetByName('_SST Recovery'),snap=JSON.parse(recovery.getRange(item.row+1,5,item.chunks,1).getValues().flat().join('')),general=ss.getSheetByName('General');
  if(sstPeople_(ss).some(p=>sstKey_(p.name)===sstKey_(snap.name))||sstRegistry_()[sstKey_(snap.name)])throw Error('That name is already in use. Nothing was restored or overwritten.');
  const slots=[{sheet:general,data:snap.general},...snap.sources.map(x=>({sheet:ss.getSheetByName(x.title),data:x.data}))];slots.forEach(x=>{const r=x.sheet.getRange(x.data.row,1,1,x.data.values.length);if(r.getValues()[0].some(v=>v!==''&&v!==null)||r.getFormulas()[0].some(Boolean)||r.getNotes()[0].some(Boolean))throw Error('The original row in '+x.sheet.getName()+' has been reused. Nothing was restored or overwritten. Ask for help to restore into another row safely.');});
  const progress=snap.entry.sheetId?ss.getSheetById(snap.entry.sheetId):null;if(snap.entry.sheetId&&!progress)throw Error('The recovery Progress sheet is missing. Nothing was restored.');if(progress&&ss.getSheets().some(s=>s.getName()===snap.progressTitle&&s.getSheetId()!==progress.getSheetId()))throw Error('A different sheet already has this Progress title. Nothing was restored.');
  const kept=sstRemovalKeptData_(ss,snap.name);slots.forEach(x=>{const d=x.data,v=d.values.map(v=>v&&typeof v==='object'&&v.sstDate?new Date(v.sstDate):v),range=x.sheet.getRange(d.row,1,1,v.length);range.setValues([v]);if(x.sheet.getName()!=='General'){x.sheet.getRange(d.row,2,1,43).clearContent();x.sheet.getRange(d.row,63,1,5).clearContent();}d.formulas.forEach((f,i)=>{if(f)x.sheet.getRange(d.row,i+1).setFormula(f);});range.setNotes([d.notes]);});
  const registry=sstRegistry_();snap.entry.archived=false;delete snap.entry.archivedAt;registry[sstKey_(snap.name)]=snap.entry;sstSaveRegistry_(registry);if(snap.entry.generalNameRange)ss.setNamedRange(snap.entry.generalNameRange,general.getRange(snap.general.row,1));if(progress){progress.setName(snap.progressTitle);progress.showSheet();}SST_ROW_CACHE_={};recovery.getRange(item.row,1).setValue('restored');PropertiesService.getDocumentProperties().deleteProperty('SST_INDEX_ROSTER_V2');sstIndex_(ss,sstPeople_(ss));SpreadsheetApp.flush();
  if(kept!==sstRemovalKeptData_(ss,snap.name))throw Error('Restoration finished but other-student preservation needs review.');console.log('DELETED STUDENT RESTORED '+snap.name);return{message:'Restored '+snap.name+' and their saved source information and Progress. Other students were kept.'};
 }finally{lock.releaseLock();}
}
