function sstReviseHelp_(sheet,row,n){const note='REVISE GOAL / PLAN — SST '+n+'\n\nUse this only AFTER you have started this meeting and need to change a goal or intervention plan.\n\n1. Change the goal or plan in the matching SST source tab.\n2. Come back to this same SST '+n+' section in Progress.\n3. Check Revise goal / plan to save the revised version. Earlier goals and progress stay saved under their original wording; new results go under the new Current goal.\n\nBefore starting a meeting, the draft updates automatically. You do not need Revise.\n\nFor a later SST meeting, enter goals in its own SST tab. Revise does not create SST 2 or SST 3.';for(let col=1;col<=3;col++)sheet.getRange(row,col).setNote(note); }
