// Stable shortcut slots point to sheet IDs, so spelling changes do not redirect old menu items.
function sstInstallDirectTabs(){
 const ss=sstBook_(),before=sstRemovalKeptData_(ss,''),q=ss.getSheetByName('Q&A - Start Here');if(q){const data=q.getDataRange().getDisplayValues(),items=[
 ['Navigation','Can I jump between tabs without scrolling along the bottom?','Yes. Use Go to tab → Student Progress → the student name for a direct jump, or choose General, Student Index, SST 1, SST2 or SST3 directly from Go to tab. The student submenu is built into the top menu. The searchable sidebar is optional under All tabs — searchable list…. Refresh the spreadsheet once if an older menu is still showing.','Works now'],
 ['Navigation','Do student shortcuts stay with the same child after a spelling correction?','Yes. Each shortcut points to the Progress sheet’s internal ID, rather than matching the name text. Corrections keep the same sheet and records. New Progress trackers receive their own shortcut. Archived and deleted trackers are omitted from the refreshed menu, and an old shortcut cannot open a hidden or deleted tracker.','Works now'],
 ['Navigation','Why might there still be a short pause after I choose a student?','Custom menu commands in Google Sheets still run through Google. Choosing a student directly removes the extra sidebar opening and search steps. The shortcut only checks and activates that one sheet; it does not rebuild trackers or check goals.','Current limit']];items.forEach(item=>{const i=data.findIndex(r=>r[1]===item[1]),row=i>=0?i+1:q.getLastRow()+1;q.getRange('A112:D112').copyTo(q.getRange(row,1,1,4),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);q.getRange(row,1,1,4).setValues([item]).setWrap(true).setFontFamily('Arial').setFontSize(11);q.autoResizeRows(row,1);});
  const r=q.getDataRange(),values=r.getValues(),forms=r.getFormulas();values.forEach((row,i)=>row.forEach((v,j)=>{if(typeof v==='string'&&!forms[i][j]&&v.includes('Go to tab → Student Progress tabs…'))q.getRange(i+1,j+1).setValue(v.replace(/Go to tab → Student Progress tabs…/g,'Go to tab → Student Progress → the student name'));}));}
 let meetingNotes=0;Object.values(sstRegistry_()).forEach(e=>Object.entries(e.records||{}).forEach(([n,r])=>{if(r.autoVersion===2&&r.controlName){const c=sstNamed_(ss,r.controlName);sstReviseHelp_(c.getSheet(),c.getRow()+1,Number(n));meetingNotes++;}}));
 const preserved=before===sstRemovalKeptData_(ss,'');if(!preserved)throw Error('Student data preservation needs review.');
 const assignment=sstNativeTabAssignments_(ss);console.log('DIRECT STUDENT TABS INSTALLED '+JSON.stringify({students:assignment.tabs.map(t=>t.name),shortcutCount:assignment.tabs.filter(t=>t.slot).length,stableSheetIds:true,sidebarOptional:true,meetingHoverNotes:meetingNotes,studentDataPreserved:preserved}));
}
function sstNativeProgressTabs_(ss){return ss.getSheets().filter(s=>s.getName().startsWith('Progress - ')&&!s.isSheetHidden()).map(s=>({id:s.getSheetId(),name:s.getName().slice('Progress - '.length)}));}
function sstNativeTabSignature_(tabs){return JSON.stringify(tabs.map(t=>[t.id,t.name]));}
function sstNativeTabAssignments_(ss){
 const props=PropertiesService.getDocumentProperties(),lock=LockService.getDocumentLock(),held=lock.hasLock(),acquired=held?false:lock.tryLock(1000),canWrite=held||acquired;
 try{const saved=props.getProperties(),used={},byId={},pending={};Object.keys(saved).forEach(key=>{const m=/^SST_DIRECT_TAB_(\d+)$/.exec(key);if(m){used[Number(m[1])]=true;byId[String(saved[key])]=Number(m[1]);}});
  const tabs=sstNativeProgressTabs_(ss).map(t=>{let slot=byId[String(t.id)];if(!slot&&canWrite){for(let i=1;i<=250;i++)if(!used[i]){slot=i;used[i]=true;pending['SST_DIRECT_TAB_'+i]=String(t.id);byId[String(t.id)]=i;break;}}return{...t,slot:slot||null};});if(Object.keys(pending).length)props.setProperties(pending);return{tabs,canWrite};
 }finally{if(acquired)lock.releaseLock();}
}
function sstBuildNavigationMenu_(ss,ui){
 const plan=sstNativeTabAssignments_(ss),students=ui.createMenu('Student Progress');let count=0;plan.tabs.forEach(t=>{if(t.slot){students.addItem(t.name,'sstDirectProgress'+t.slot);count++;}});if(!count)students.addItem('No active trackers — open Student Index','sstOpenIndex');students.addSeparator().addItem('Refresh student shortcuts','sstRefreshStudentShortcuts');
 ui.createMenu('Go to tab').addItem('General','sstGoGeneral').addItem('Student Index','sstOpenIndex').addSeparator().addItem('SST 1','sstGoSST1').addItem('SST2','sstGoSST2').addItem('SST3','sstGoSST3').addSeparator().addSubMenu(students).addItem('All tabs — searchable list…','sstAllTabMenu').addSeparator().addItem('Q&A — Start Here','sstGoQA').addItem('Dropdown settings','sstOpenDropdownSettings').addToUi();if(plan.canWrite)PropertiesService.getDocumentProperties().setProperty('SST_DIRECT_TAB_SIGNATURE',sstNativeTabSignature_(plan.tabs));
}
function sstMaybeRefreshNativeTabs_(ss){const signature=sstNativeTabSignature_(sstNativeProgressTabs_(ss));if(PropertiesService.getDocumentProperties().getProperty('SST_DIRECT_TAB_SIGNATURE')===signature)return;try{sstBuildNavigationMenu_(ss,SpreadsheetApp.getUi());}catch(menuContext){console.log('Native student shortcuts refresh when the spreadsheet is opened.');}}
function sstRefreshStudentShortcuts(){sstBuildNavigationMenu_(sstBook_(),SpreadsheetApp.getUi());}
function sstDirectProgress_(slot){const ss=sstBook_(),id=Number(PropertiesService.getDocumentProperties().getProperty('SST_DIRECT_TAB_'+slot)),sheet=id?ss.getSheetById(id):null;if(!sheet||sheet.isSheetHidden()||!sheet.getName().startsWith('Progress - ')){ss.toast('This tracker is not active. Use Go to tab → Student Progress → Refresh student shortcuts.','Student shortcut',-1);return;}ss.setActiveSheet(sheet);}
