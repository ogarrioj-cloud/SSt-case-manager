// Grouped menus clarify which tab owns an action. Navigation never edits data.
function sstInstallGroupedMenus(){
 const ss=sstBook_();try{sstBuildMenus_();}catch(menuContext){console.log('Menus load when the spreadsheet is opened. Updating the saved guidance now.');}
 const path=s=>String(s).replace(/SST Case Manager → Student actions — edit name \/ archive \/ delete/g,'SST Case Manager → Students — General → Edit name / archive / delete student').replace(/SST Case Manager → Restore a deleted student/g,'SST Case Manager → Students — General → Restore a deleted student').replace(/SST Case Manager → Remove unused entry or archive student/g,'SST Case Manager → Students — General → Edit name / archive / delete student');
 const q=ss.getSheetByName('Q&A - Start Here');if(q){const r=q.getDataRange(),v=r.getValues(),f=r.getFormulas();v.forEach((row,i)=>row.forEach((x,j)=>{if(typeof x==='string'&&!f[i][j]&&path(x)!==x)q.getRange(i+1,j+1).setValue(path(x));}));const items=[
 ['Menus and help','Why is the menu called SST Case Manager now?','It manages the whole Case Manager, with headings to show where actions belong. Open Students — General for names, archive, delete and recovery; Goals — SST 1 / SST2 / SST3 for goal guidance; Progress — student Progress tabs for starting or revising a meeting and adding progress rows; Reports — print or PDF for printing. Use the separate Go to tab menu to navigate.','Works now'],
 ['Menus and help','Why do I see the Case Manager menu on every tab?','Google Sheets keeps custom menus visible throughout the workbook. The submenu headings tell you where each action belongs: Students — General; Goals — SST 1 / SST2 / SST3; Progress — student Progress tabs; Reports — print or PDF; Writing evidence — Student Index; Settings / help. Start, revise and copy-plan commands check the tab before doing anything.','Works now'],
 ['Meetings and goals','What does Start meeting mean when I am in SST2?','SST2 is where you prepare that student’s second meeting goals and intervention plans. It does not mean the meeting has started. Click that student’s row, then SST Case Manager → Goals — SST 1 / SST2 / SST3 → Open Progress for the selected student row. In their SST 2 Progress section, review the draft and check Start this meeting when ready. This saves the plan and opens the progress rows for that meeting. It does not start SST 1 or another student’s meeting.','Works now'],
 ['Navigation','Can I jump between tabs without scrolling along the bottom?','Yes. Use the Go to tab menu at the top for General, Student Index, SST 1, SST2, SST3, Q&A or Dropdown settings. Choose Student Progress tabs… or All tabs — searchable list… for a sidebar. Search by student name or tab name, then click its button. The sidebar stays open until you close its ×. Refresh the list after adding or archiving students. Hidden archived and deleted tabs are not shown.','Works now'],
 ['Menus and help','Where did Start meeting and the other old menu options go?','They are grouped by task. Start draft meeting and Save revised goal / plan are inside Progress — student Progress tabs. Student name editing, archive, delete and recovery are inside Students — General. Printing is inside Reports — print or PDF. Shared dropdown choices and Q&A are inside Settings / help. The separate Go to tab menu handles navigation.','Works now']];items.forEach(item=>{const rows=q.getDataRange().getDisplayValues(),i=rows.findIndex(r=>r[1]===item[1]),row=i>=0?i+1:q.getLastRow()+1;q.getRange('A112:D112').copyTo(q.getRange(row,1,1,4),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);q.getRange(row,1,1,4).setValues([item]).setWrap(true).setFontFamily('Arial').setFontSize(11);q.autoResizeRows(row,1);});}
 ss.getSheets().forEach(s=>{const r=s.getDataRange(),notes=r.getNotes();let changed=false;notes.forEach(row=>row.forEach((x,i)=>{if(path(x)!==x){row[i]=path(x);changed=true;}}));if(changed)r.setNotes(notes);});
 console.log('GROUPED MENUS INSTALLED '+JSON.stringify({studentCount:sstPeople_(ss).length,groupedCaseMenu:true,tabNavigationMenu:true,progressCommandsRequireProgressTab:true}));
}
function sstBuildMenus_(){
 const ui=SpreadsheetApp.getUi();sstBuildNavigationMenu_(sstBook_(),ui);
 ui.createMenu('SST Case Manager')
 .addSubMenu(ui.createMenu('Students — General').addItem('Edit name / archive / delete student','sstReviewStudentRemoval').addItem('Restore an archived student — Tracker controls','sstTrackerControls').addItem('Restore a deleted student','sstRestoreDeletedStudent'))
 .addSubMenu(ui.createMenu('Goals — SST 1 / SST2 / SST3').addItem('How to enter or clear goals','sstGoalTabHelp').addItem('Open Progress for the selected student row','sstOpenRowProgress').addItem('Open student + SST chosen in Student Index','sstCreateSelected').addSeparator().addItem('Copy plan to next SST draft — from Progress','sstNextDraft'))
 .addSubMenu(ui.createMenu('Progress — student Progress tabs').addItem('Start draft meeting — click its section first','sstStartMeeting').addItem('Save revised goal / plan — click its section first','sstReviseMeeting').addItem('Add progress rows / open Tracker controls','sstTrackerControls'))
 .addSubMenu(ui.createMenu('Reports — print or PDF').addItem('Print / save PDF — choose student and SSTs','sstPrintReport').addSeparator().addItem('Sheet print layout — Progress tab only','sstMenuPrintLayout').addItem('Return to entry layout — Progress tab only','sstMenuEntryLayout'))
 .addSubMenu(ui.createMenu('Writing evidence — Student Index').addItem('How to choose writing evidence','sstWritingTabHelp').addItem('Save checked writing pieces to the chosen SST','sstAddWriting'))
 .addSubMenu(ui.createMenu('Writing feedback').addItem('Open Rubric Connections','sstRubricConnections').addItem('Manual / Rubric — Writing Controls','sstWritingControls').addItem('Preview writing feedback','sstPreviewWritingFeedback').addItem('Update Writing Feedback','sstUpdateWritingFeedback').addItem('Review import results','sstWritingImportReview').addSubMenu(ui.createMenu('Switch everyone to Rubric').addItem('All connected writing areas','sstEveryoneToRubric').addItem('One writing area…','sstChooseBulkRubricArea')).addSeparator().addItem('Refresh Writing Controls for new students','sstSetupRubricConnections').addItem('Restore last writing import','sstRestoreLastWritingImport'))
 .addSubMenu(ui.createMenu('Settings / help').addItem('Shared Progress dropdown choices','sstOpenDropdownSettings').addItem('Open Q&A — Start Here','sstGoQA').addItem('Check automatic drafts and connections','sstRefresh')).addToUi();
}
function sstRequireProgressTab_(ss,action){if(ss.getActiveSheet().getName().startsWith('Progress - '))return true;ss.toast('This action belongs in a student’s Progress tab. Use Go to tab → Student Progress → the student name, open the student, then click inside the SST meeting section you want. No meeting was changed.',action+' — Progress tabs only',-1);return false;}
function sstGoGeneral(){sstGoTitle_('General');}
function sstGoSST1(){sstGoTitle_('SST 1');}
function sstGoSST2(){sstGoTitle_('SST2');}
function sstGoSST3(){sstGoTitle_('SST3');}
function sstGoQA(){sstGoTitle_('Q&A - Start Here');}
function sstGoTitle_(title){const ss=sstBook_(),s=ss.getSheetByName(title);if(!s||s.isSheetHidden())throw Error('This tab is not available in the active view.');ss.setActiveSheet(s);}
function sstGoalTabHelp(){sstBook_().toast('In SST 1, SST2 or SST3, use the student’s row to enter goals and intervention plans. Clearing only those input cells updates a draft; started Progress records keep their saved plan and results. To open the matching tracker: SST Case Manager → Goals — SST 1 / SST2 / SST3 → Open Progress for the selected student row.','Goals belong in the SST tabs',-1);}
function sstWritingTabHelp(){sstBook_().toast('Go to tab → Student Index. Choose the student and SST number, check the writing pieces you want to save, then SST Case Manager → Writing evidence — Student Index → Save checked writing pieces to the chosen SST.','Writing evidence — use Student Index',-1);}
function sstMenuPrintLayout(){const ss=sstBook_();if(sstRequireProgressTab_(ss,'Sheet print layout'))sstPreparePrint();}
function sstMenuEntryLayout(){const ss=sstBook_();if(sstRequireProgressTab_(ss,'Return to entry layout'))sstEntryView();}
function sstOpenRowProgress(){
 const ss=sstBook_(),s=ss.getActiveSheet(),title=s.getName(),row=s.getActiveRange().getRow(),n=SST_ROUNDS.indexOf(title)+1;
 if((title!=='General'&&!n)||row<3){ss.toast('Select the student’s row in General, SST 1, SST2 or SST3 first. This opens a tracker without starting a meeting.','Choose a student row',-1);return;}
 const name=s.getRange(row,1).getDisplayValue().trim(),p=sstPeople_(ss).find(p=>sstKey_(p.name)===sstKey_(name)),entry=p&&sstRegistry_()[sstKey_(p.name)];
 if(!p||!entry||entry.archived){ss.toast('Choose an active student row. Archived students can be restored under Students — General.','Student tracker',-1);return;}
 if(n){const rec=entry.records[n];if(!rec){ss.toast('No SST '+n+' draft exists yet for '+p.name+'. Enter a goal and plan in this SST tab first, then try again. Nothing was started.','No draft for this SST yet',-1);return;}const r=sstNamed_(ss,rec.rangeName);ss.setActiveSheet(r.getSheet());r.getSheet().getRange(r.getRow(),1).activate();return;}
 const progress=entry.sheetId?ss.getSheetById(entry.sheetId):null;if(!progress){ss.toast('Enter the student’s goals in the appropriate SST tab first. Their Progress draft appears automatically.','No Progress tracker yet',-1);return;}ss.setActiveSheet(progress);progress.getRange('A1').activate();
}
function sstProgressTabMenu(){sstShowTabSidebar_('progress');}
function sstAllTabMenu(){sstShowTabSidebar_('all');}
function sstTabMenuData(){const ss=sstBook_();return ss.getSheets().filter(s=>!s.isSheetHidden()).map(s=>{const name=s.getName();let group=name.startsWith('Progress - ')?'Student Progress':SST_ROUNDS.includes(name)?'Meeting goals':['General',SST_INDEX].includes(name)?'Main tabs':'Lists and help';return{id:s.getSheetId(),name,group};});}
function sstOpenTabById(id){const ss=sstBook_(),s=ss.getSheetById(Number(id));if(!s||s.isSheetHidden())throw Error('This tab is hidden or unavailable. Refresh the list.');ss.setActiveSheet(s);return s.getName();}
function sstShowTabSidebar_(mode){const data=JSON.stringify({tabs:sstTabMenuData(),mode}).replace(/</g,'\\u003c');const html='<!doctype html><html><head><style>body{font:14px Arial;color:#111;margin:16px}h2{font-size:19px;margin:0 0 12px}h3{font-size:14px;margin:18px 0 6px;border-bottom:1px solid #cad5d9;padding-bottom:6px}input,select{box-sizing:border-box;width:100%;padding:9px;margin-bottom:9px;font:14px Arial;border:1px solid #8a9ca2}button.tab{display:block;text-align:left;width:100%;margin:6px 0;padding:10px;background:#eef4f1;border:1px solid #b6c7c4;border-radius:3px;font:14px Arial;cursor:pointer}button.refresh{padding:7px 10px;background:#fff;border:1px solid #8a9ca2;font:13px Arial;cursor:pointer}#status{font-size:13px;line-height:1.4}</style></head><body><h2>Go to a tab</h2><input id="search" aria-label="Search student or tab" placeholder="Search student or tab"><select id="view" aria-label="Which tabs"><option value="all">All visible tabs</option><option value="progress">Student Progress only</option></select><button id="refresh" class="refresh">Refresh tab list</button><p id="status" role="status">Click a tab below. This panel stays open.</p><div id="tabs"></div><script>const initial='+data+';('+sstTabMenuClient_.toString()+')();</script></body></html>';SpreadsheetApp.getUi().showSidebar(HtmlService.createHtmlOutput(html).setTitle('Go to a tab'));}
function sstTabMenuClient_(){const $=id=>document.getElementById(id);let tabs=initial.tabs;$('view').value=initial.mode;function render(){const query=$('search').value.trim().toLowerCase();$('tabs').replaceChildren();let count=0;for(const group of ['Main tabs','Meeting goals','Student Progress','Lists and help']){const matches=tabs.filter(t=>t.group===group&&($('view').value!=='progress'||group==='Student Progress')&&t.name.toLowerCase().includes(query));if(!matches.length)continue;const h=document.createElement('h3');h.textContent=group;$('tabs').appendChild(h);matches.forEach(t=>{count++;const b=document.createElement('button');b.className='tab';b.textContent=t.name;b.onclick=()=>{b.disabled=true;google.script.run.withSuccessHandler(name=>{$('status').textContent='Opened '+name+'.';b.disabled=false;}).withFailureHandler(e=>{$('status').textContent=e.message;b.disabled=false;}).sstOpenTabById(t.id);};$('tabs').appendChild(b);});}if(!count){$('tabs').textContent='No matching tabs. Try another name or show all tabs.';}}$('search').oninput=render;$('view').onchange=render;$('refresh').onclick=()=>{$('status').textContent='Refreshing…';google.script.run.withSuccessHandler(list=>{tabs=list;render();$('status').textContent='Tab list updated.';}).withFailureHandler(e=>{$('status').textContent=e.message;}).sstTabMenuData();};render();}
