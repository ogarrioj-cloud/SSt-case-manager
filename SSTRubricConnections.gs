 }finally{lock.releaseLock();}}
function sstRestoreLastWritingImport(){const ss=sstBook_(),h=ss.getSheetByName(SRC_SHEETS.history);if(!h||h.getLastRow()<2){ss.toast('No writing import has been saved yet.');return;}const rows=h.getRange(2,1,h.getLastRow()-1,10).getValues(),run=rows[rows.length-1][1],people=srcPeople_(ss),cols=srcColumns_(ss),control=ss.getSheetByName(SRC_SHEETS.controls),cv=control.getRange(7,1,control.getLastRow()-6,10).getValues();let count=0;rows.filter(r=>r[1]===run).forEach(r=>{const p=people.find(p=>p.id===r[2]);if(!p)return;const cell=ss.getSheetByName('General').getRange(p.row,cols[r[4]]);if(String(cell.getValue())!==String(r[7]))return;cell.setValue(r[6]||r[5]);const i=cv.findIndex(v=>v[7]===p.id&&v[8]===r[4]);if(i>=0)control.getRange(i+7,3).setValue('Manual'),control.getRange(i+7,5).setValue('Restored previous text — Manual');count++;});ss.toast(count+' writing entries restored. Later manual edits preserved.','Restore writing import',10);}

