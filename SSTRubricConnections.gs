function sstPreviewWritingFeedback(){const ss=sstBook_(),plan=srcPlan_(ss);ss.setActiveSheet(srcReview_(ss,plan));console.log('PREVIEW: '+plan.filter(x=>x.status==='Ready').length+' ready; '+plan.filter(x=>x.status!=='Ready').length+' skipped. No General writing cells changed.');}
function sstUpdateWritingFeedback(){
 const ss=sstBook_(),lock=LockService.getDocumentLock();lock.waitLock(30000);try{const plan=srcPlan_(ss),ready=plan.filter(x=>x.status==='Ready'),g=ss.getSheetByName('General'),controls=ss.getSheetByName(SRC_SHEETS.controls),history=ss.getSheetByName(SRC_SHEETS.history),run=Utilities.getUuid(),time=new Date();
