 });
 const counts={};out.filter(x=>x.status==='Ready').forEach(x=>{const k=x.p.id+'|'+x.field;counts[k]=(counts[k]||0)+1;});out.forEach(x=>{if(x.status==='Ready'&&counts[x.p.id+'|'+x.field]>1)x.status='Conflict: multiple enabled rubrics match this area';});return out;
}
