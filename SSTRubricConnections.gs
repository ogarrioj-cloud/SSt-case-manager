}
function srcLoad_(url,type,lang){
 const match=String(url).match(/\/spreadsheets\/d\/([a-zA-Z0-9_-]+)/);if(!match)throw Error('Paste a full Google Sheets rubric link.');if(!['Narrative','Opinion'].includes(type))throw Error('Unsupported template: choose Narrative or Opinion.');if(!['Spanish','English'].includes(lang))throw Error('Choose Spanish or English.');
 const book=SpreadsheetApp.openById(match[1]),roster=book.getSheetByName('Evaluation Roster'),settings=book.getSheetByName('Feedback & Criteria Settings');if(!roster||!settings)throw Error('Missing Evaluation Roster or Feedback & Criteria Settings.');
 const header=roster.getRange('A1:AD7').getDisplayValues(),h=header[6].map(srcKey_);if(!/last name/.test(h[1])||!/first name/.test(h[2])||!/paragraph/.test(h[16])||!/indent/.test(h[17]))throw Error('Unrecognized roster layout. Required name / paragraph / indentation headers moved.');
 if(!header.flat().join(' ').toLowerCase().includes(type.toLowerCase()))throw Error('Selected writing type does not match this rubric.');
 const lib=settings.getRange(1,1,settings.getLastRow(),7).getDisplayValues(),notes={};lib.forEach(r=>{if(r[6])notes[r[6]]=r[lang==='Spanish'?3:5];});
 const layout=type==='Narrative'?(/dialogue/.test(h[7])&&/transition/.test(h[10])?'reordered':/transition/.test(h[7])&&/dialogue/.test(h[10])?'original':''): 'opinion';if(!layout)throw Error('Narrative layout not recognized. No feedback imported.');
 if(type==='Opinion'&&(!/reason/.test(h[6])||!/transition/.test(h[10])||!/(conclusion|restated opinion)/.test(h[13])))throw Error('Opinion layout not recognized.');
 const data=roster.getLastRow()>=8?roster.getRange(8,1,roster.getLastRow()-7,30).getValues():[];
 return {id:book.getId(),title:book.getName(),type,lang,layout,lib,notes,records:data.filter(r=>r[1]||r[2]).map((r,i)=>({last:String(r[1]).trim(),first:String(r[2]).trim(),full:(String(r[2]).trim()+' '+String(r[1]).trim()).trim(),values:r}))};
}
function srcFeedback_(source,record){
 const r=record.values,yes=c=>r[c-1]===true;if(!r.slice(3,26).some(v=>v===true))return {status:'Ungraded — existing text kept'};
 const items=[],notes=source.notes;const add=code=>{const text=notes[code];if(!text||/^#(ERROR|REF|VALUE|N\/A)/.test(text))throw Error('Missing feedback note: '+code);items.push(text);};
 const binary=(c,a,b)=>add(yes(c)?a:b);const group=(cols,codes,label)=>{const hits=cols.map((c,i)=>yes(c)?i:-1).filter(i=>i>=0);if(hits.length!==1)throw Error(label+': select exactly one choice. Existing text kept.');add(codes[hits[0]]);};
 try{if(source.type==='Narrative'){
 binary(4,'INTRO_HOOK_YES','INTRO_HOOK_NO');binary(5,'INTRO_SETUP_YES','INTRO_SETUP_NO');binary(6,'INTRO_FOCUS_YES','INTRO_FOCUS_NO');binary(7,'SEQ_YES','SEQ_NO');
 const original=source.layout==='original';group(original?[8,9,10]:[11,12,13],['TRANS_VARIETY','TRANS_REPETITIVE','TRANS_NONE'],'Transitions');binary(original?11:8,'DIAL_YES','DIAL_NO');binary(original?12:9,'DESC_YES','DESC_NO');binary(original?13:10,'FIG_YES','FIG_NO');group([16,15,14],['CONC_GREAT','CONC_ABRUPT','CONC_NONE'],'Conclusion');binary(17,'PARA_YES','PARA_NO');binary(18,'INDENT_YES','INDENT_NO');group([19,20,21,22],['MECH_L1','MECH_L2','MECH_L3','MECH_L4'],'Mechanics');group([23,24,25,26],['GRAM_L1','GRAM_L2','GRAM_L3','GRAM_L4'],'Grammar');
 }else{binary(4,'HOOK_YES','HOOK_NO');binary(5,'BRIDGE_YES','BRIDGE_NO');binary(6,'THESIS_YES','THESIS_NO');group([7,8,9,10],['EVID_L4','EVID_L3','EVID_L2','EVID_L1'],'Evidence');group([11,12,13],['TRANS_L3','TRANS_L2','TRANS_L1'],'Transitions');group([14,15,16],['CONC_L3','CONC_L2','CONC_L1'],'Conclusion');
 [yes(17)?20:21,yes(18)?22:23].forEach(n=>{const text=source.lib[n-1][source.lang==='Spanish'?3:5];if(!text)throw Error('Missing editing feedback');items.push(text);});group([19,20,21,22],['MECH_L4','MECH_L3','MECH_L2','MECH_L1'],'Mechanics');group([23,24,25,26],['GRAM_L4','GRAM_L3','GRAM_L2','GRAM_L1'],'Grammar');}
 return {status:'Ready',text:items.join('\n')};}catch(e){return {status:e.message};}
}
function srcMatch_(records,name,override){const key=srcKey_(override||name);let hits=records.filter(r=>srcKey_(r.full)===key||srcKey_(r.last+', '+r.first)===key);if(!hits.length&&!override)hits=records.filter(r=>srcKey_(r.first)===key);return hits.length===1?{record:hits[0]}:{status:hits.length?'Ambiguous name — enter exact rubric name':'Not found — existing text kept'};}
function srcPlan_(ss){
 const people=srcPeople_(ss),cols=srcColumns_(ss),g=ss.getSheetByName('General'),controls=ss.getSheetByName(SRC_SHEETS.controls);if(!controls)throw Error('Run setup first.');const cv=controls.getLastRow()>6?controls.getRange(7,1,controls.getLastRow()-6,10).getValues():[],cs=ss.getSheetByName(SRC_SHEETS.connections),config=cs.getLastRow()>6?cs.getRange(7,1,cs.getLastRow()-6,8).getValues():[],out=[];
 config.forEach((c,i)=>{if(c[0]!==true)return;const field=srcField_(c[2],c[3]),conn=i+7;let source;try{if(!field)throw Error('Choose writing type and language');source=srcLoad_(c[1],c[2],c[3]);cs.getRange(conn,5).setValue('Source checked: '+source.title);}catch(e){cs.getRange(conn,5).setValue(e.message);out.push({conn,status:'Connection error: '+e.message});return;}
